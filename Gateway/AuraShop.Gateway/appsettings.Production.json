{
  "ReverseProxy": {
    "Routes": {
      "basket": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/api/{version}/baskets/{**catch-all}"
        }
      },
      "catalog-products": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/{version}/products/{**catch-all}"
        }
      },
      "catalog-categories": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/{version}/categories/{**catch-all}"
        }
      },
      "discount": {
        "ClusterId": "discount-cluster",
        "Match": {
          "Path": "/api/{version}/discounts/{**catch-all}"
        }
      },
      "file": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/api/{version}/files/{**catch-all}"
        }
      },
      "order": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/{version}/orders/{**catch-all}"
        }
      },
      "auth": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/{version}/auth/{**catch-all}"
        }
      },
      "payment": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/{version}/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "basket-cluster": {
        "Destinations": {
          "basket": {
            "Address": "http://aurashop.basket:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://aurashop.catalog:8080/"
          }
        }
      },
      "discount-cluster": {
        "Destinations": {
          "discount": {
            "Address": "http://aurashop.discount:8080/"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file": {
            "Address": "http://aurashop.file:8080/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order": {
            "Address": "http://aurashop.order:8080/"
          }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://aurashop.keycloak:8080/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": {
            "Address": "http://aurashop.payment:8080/"
          }
        }
      }
    }
  },
  "Keycloak": {
    "Authority": "http://aurashop.keycloak:8080",
    "Realm": "aurashop",
    "Audience": "aurashop-api",
    "ClientId": "aurashop-api",
    "RequireHttpsMetadata": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
