{
  "DatabaseSettings": {
    "ConnectionString": "mongodb://catalog.mongo:27017",
    "DatabaseName": "AuraShopCatalogDb",
    "CategoryCollectionName": "Categories",
    "ProductCollectionName": "Products"
  },
  "Keycloak": {
    "Authority": "http://aurashop.keycloak:8080",
    "Realm": "aurashop",
    "Audience": "aurashop-api",
    "ClientId": "aurashop-api",
    "RequireHttpsMetadata": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
